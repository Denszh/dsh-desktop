{
  "name": "dsh-desktop",
  "version": "0.1.5",
  "description": "DeepSeek Harness Desktop — Electron shell that spawns and manages dsh web",
  "main": "src/main/index.js",
  "type": "commonjs",
  "license": "MIT",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "release": "bash scripts/release.sh",
    "build:dsh-runtime": "bash scripts/build-dsh-runtime.sh"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
